{
  "name": "japfa_backend_basecode",
  "version": "1.0.0",
  "packageManager": "pnpm@8.8.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "docker": "podman compose up -d",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "clean": "rm -rf dist",
    "generate:module": "node scripts/generate-module.js",
    "migrate": "tsx ./node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "rollback": "tsx ./node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.ts",
    "make:migration": "tsx ./node_modules/knex/bin/cli.js migrate:make --knexfile knexfile.ts",
    "make:seed": "tsx ./node_modules/knex/bin/cli.js seed:make --knexfile knexfile.ts",
    "seed": "tsx ./node_modules/knex/bin/cli.js seed:run --knexfile knexfile.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "knex": "^3.3.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "redis": "^6.1.0",
    "snowflake-sdk": "^3.1.0",
    "zod": "^4.4.3"
  }
}
